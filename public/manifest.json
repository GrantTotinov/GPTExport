{
    "manifest_version": 3,
    "name": "GPTExport",
    "version": "0.1.0",
    "description": "Export ChatGPT conversations as Markdown.",

    "permissions": [
        "activeTab",
        "clipboardWrite",
        "offscreen"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": [
                "https://chatgpt.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],

    "action": {
        "default_title": "GPTExport",
        "default_popup": "popup.html"
    }
}
